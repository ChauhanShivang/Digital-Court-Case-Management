@model List<CourtCaseManagementSystem.Core.Entities.Case>
@{
    ViewData["Title"] = "Judgment Drafts";
}

<h1 class="h3 mb-4 text-gray-800">Judgment Drafts</h1>

<div class="card shadow mb-4">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Case No</th>
                <th>Case Title</th>
                <th>Draft Status</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>

            @foreach (var c in Model)
            {
                <tr>

                    <td>@c.CaseNumber</td>
                    <td>@c.Title</td>

                    <td>
                        @if (c.Judgment == null)
                        {
                            <span class="badge badge-warning">No Draft</span>
                        }
                        else
                        {
                            <span class="badge badge-success">@c.Judgment.Status</span>
                        }
                    </td>

                    <td>

                        @if (c.Judgment == null)
                        {
                            <a asp-controller="Judgment"
                               asp-action="Create"
                               asp-route-caseId="@c.Id"
                               class="btn btn-sm btn-success">
                                Write Draft
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Judgment"
                               asp-action="Edit"
                               asp-route-caseId="@c.Id"
                               class="btn btn-sm btn-primary">
                                Edit Draft
                            </a>
                        }

                    </td>

                </tr>
            }

            </tbody>
        </table>
    </div>
</div>