@model List<CourtCaseManagementSystem.Core.Entities.Court>

<h1 class="h3 mb-4 text-gray-800">Courts Management</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Court
</a>

<div class="card shadow mb-4">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Court Name</th>
                <th>Location</th>
                <th>Type</th>
            </tr>
            </thead>
            <tbody>
            @foreach(var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Location</td>
                    <td>@c.CourtType</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>