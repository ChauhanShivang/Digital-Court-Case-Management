<h2>Adjournment Requests</h2>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Case</th>
        <th>Reason</th>
        <th>Status</th>
        <th>Action</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Hearing?.Case?.CaseNumber</td>
            <td>@r.Reason</td>
            <td>@r.Status</td>

            <td>
                @if (r.Status == "Approved")
                {
                    <span class="badge badge-success px-3 py-2">Approved</span>
                }
                else if (r.Status == "Rejected")
                {
                    <span class="badge badge-danger px-3 py-2">Rejected</span>
                }
                else if (r.Status == "Pending")
                {
                    <span class="badge badge-warning px-3 py-2 mr-2">Pending</span>

                    <a asp-action="Approve" asp-route-id="@r.Id"
                       class="btn btn-success btn-sm mr-1">
                        Approve
                    </a>

                    <a asp-action="Reject" asp-route-id="@r.Id"
                       class="btn btn-danger btn-sm">
                        Reject
                    </a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>