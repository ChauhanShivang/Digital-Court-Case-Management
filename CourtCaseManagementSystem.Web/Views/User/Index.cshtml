@model List<CourtCaseManagementSystem.Core.Entities.User>

<h1 class="h3 mb-4 text-gray-800">User Management</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create User
</a>

<table class="table table-bordered">

    <thead>
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    </thead>

    <tbody>

    @foreach (var u in Model)
    {
        <tr>

            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@u.Role?.Name</td>

            <td>
                @if (u.IsActive)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-danger">Inactive</span>
                }
            </td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@u.Id"
                   class="btn btn-sm btn-primary">
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-route-id="@u.Id"
                   class="btn btn-sm btn-danger">
                    Delete
                </a>

            </td>

        </tr>
    }

    </tbody>

</table>