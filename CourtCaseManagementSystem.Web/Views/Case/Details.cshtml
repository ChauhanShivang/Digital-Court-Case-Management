@using CourtCaseManagementSystem.Core.Entities
@model CourtCaseManagementSystem.Core.Entities.Case
@{
    ViewData["Title"] = "Case Details";
}

<h1 class="h3 mb-4 text-gray-800">Case Details</h1>

<div class="card shadow mb-4">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="caseTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="overview-tab" data-toggle="tab" href="#overview" role="tab">Overview</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="hearings-tab" data-toggle="tab" href="#hearings" role="tab">Hearings</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="documents-tab" data-toggle="tab" href="#documents" role="tab">Documents</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="judgment-tab" data-toggle="tab" href="#judgment" role="tab">Judgment</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="timeline-tab" data-toggle="tab" href="#timeline" role="tab">Timeline</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="applications-tab" data-toggle="tab" href="#applications" role="tab">
                    Applications
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#fir">FIR</a>
            </li>

            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#chargesheet">Charge Sheet</a>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <div class="tab-content" id="caseTabContent">

            <!-- Overview Tab -->
            <div class="tab-pane fade show active" id="overview" role="tabpanel">
                <p><strong>Case No:</strong> @Model.CaseNumber</p>
                <p><strong>Title:</strong> @Model.Title</p>
                <p><strong>Case Type:</strong> @Model.CaseType</p>
                <p><strong>Court:</strong> @Model.Court?.Name</p>
                <p><strong>Lawyers:</strong></p>

                <ul>
                    @foreach (var l in Model.CaseLawyers ?? new List<CaseLawyer>())
                    {
                        <li>@l.Lawyer?.FullName</li>
                    }
                </ul>

                <p>
                    <strong>Status:</strong>

                    @if (Model.Status == "Registered")
                    {
                        <span class="badge badge-info">Registered</span>
                    }
                    else if (Model.Status == "Active")
                    {
                        <span class="badge badge-warning">Active</span>
                    }
                    else if (Model.Status == "Closed")
                    {
                        <span class="badge badge-success">Closed</span>
                    }

                </p>
            </div>

            <!-- Hearings Tab -->
            <div class="tab-pane fade" id="hearings" role="tabpanel">
                @if (Context.Session.GetString("UserRole") == "Judge")
                {
                    <a asp-controller="Hearing"
                       asp-action="Create"
                       asp-route-caseId="@Model.Id"
                       class="btn btn-primary mb-3">
                        Schedule Hearing
                    </a>
                }
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>Hearing Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                    </thead>
                    <tbody>

                    @if (Model.Hearings != null && Model.Hearings.Any())
                    {
                        foreach (var h in Model.Hearings)
                        {
                            <tr>
                                <td>@h.HearingDate.ToString("dd MMM yyyy")</td>
                                <td>@h.Status</td>
                                <td>@h.Remarks</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                No hearings scheduled
                            </td>
                        </tr>
                    }

                    </tbody>
                </table>
            </div>

            <!-- Documents Tab -->
            <div class="tab-pane fade" id="documents" role="tabpanel">
                <!-- Upload Form -->
                <form asp-controller="Document"
                      asp-action="Upload"
                      method="post"
                      enctype="multipart/form-data"
                      class="mb-3">

                    <input type="hidden" name="caseId" value="@Model.Id"/>

                    <div class="form-group">
                        <label>Document Type</label>
                        <select name="documentType" class="form-control">
                            <option>Evidence</option>
                            <option>Affidavit</option>
                            <option>Petition</option>
                            <option>Vakalatnama</option>
                            <option>Other</option>
                        </select>
                    </div>

                    <div class="form-group mt-2">
                        <input type="file" name="file" class="form-control"/>
                    </div>

                    <button class="btn btn-primary mt-2">
                        Upload Document
                    </button>

                </form>

                @{
                    var userId = Context.Session.GetInt32("UserId");

                    bool hasVakalatnama = Model.Documents != null &&
                                          Model.Documents.Any(d => d.IsVakalatnama 
                                                                   && d.UploadedByUserId == userId);
                }

                @if (Context.Session.GetString("UserRole") == "Lawyer" && !hasVakalatnama)
                {
                    <div class="alert alert-warning">
                        ⚠ Please upload Vakalatnama to access case documents.
                    </div>
                }

                <!-- Documents Table -->
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>Document</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Download</th>
                    </tr>
                    </thead>

                    <tbody>

                    @if (Model.Documents != null && Model.Documents.Any() 
                                                 && (Context.Session.GetString("UserRole") != "Lawyer" || hasVakalatnama))
                    {
                        foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>@doc.FileName</td>
                                <td>@doc.DocumentType</td>
                                <td>@doc.UploadedAt.ToString("dd MMM yyyy")</td>

                                <td>
                                    <a asp-controller="Document"
                                       asp-action="Download"
                                       asp-route-id="@doc.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        Download
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                No documents uploaded yet
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>
            </div>

            <!-- Judgment Tab -->
            <div class="tab-pane fade" id="judgment" role="tabpanel">

                @if (Model.Judgment != null)
                {
                    <!-- ✅ STATUS -->
                    <p>
                        <strong>Status:</strong>

                        @if (Model.Judgment.Status == "Draft")
                        {
                            <span class="badge badge-secondary">Draft</span>
                        }
                        else if (Model.Judgment.Status == "Under Review")
                        {
                            <span class="badge badge-warning">Under Review</span>
                        }
                        else if (Model.Judgment.Status == "Pronounced")
                        {
                            <span class="badge badge-info">Pronounced</span>
                        }
                        else if (Model.Judgment.Status == "Delivered")
                        {
                            <span class="badge badge-success">Delivered</span>
                        }
                    </p>

                    <!-- ✅ CONTENT -->
                    <p>@Model.Judgment.Content</p>

                    <!-- ✅ DOWNLOAD (LAWYER ONLY) -->
                    @if (Model.Judgment.Status == "Delivered"
                         && Context.Session.GetString("UserRole") == "Lawyer")
                    {
                        <a asp-controller="Judgment"
                           asp-action="Download"
                           asp-route-id="@Model.Judgment.Id"
                           class="btn btn-success mt-2">
                            Download Judgment
                        </a>
                    }

                    <!-- ✅ APPEAL BUTTON -->
                    @* @if (Model.Judgment.Status == "Delivered" *@
                    @*     && Context.Session.GetString("UserRole") == "Lawyer") *@
                    @* { *@
                    @*     <a asp-controller="Case" *@
                    @*        asp-action="FileAppeal" *@
                    @*        asp-route-id="@Model.Id" *@
                    @*        class="btn btn-danger mt-2 ml-2"> *@
                    @*         File Appeal *@
                    @*     </a> *@
                    @* } *@

                    <!-- ✅ EDIT (JUDGE ONLY) -->
                    @if (Context.Session.GetString("UserRole") == "Judge")
                    {
                        <a asp-controller="Judgment"
                           asp-action="Edit"
                           asp-route-caseId="@Model.Id"
                           class="btn btn-primary mt-2 ml-2">
                            Edit Judgment
                        </a>
                    }
                }
                else
                {
                    <!-- ✅ CREATE (JUDGE ONLY) -->
                    if (Context.Session.GetString("UserRole") == "Judge")
                    {
                        <a asp-controller="Judgment"
                           asp-action="Create"
                           asp-route-caseId="@Model.Id"
                           class="btn btn-success">
                            Write Judgment
                        </a>
                    }
                }
            </div>
            
            <div class="tab-pane fade" id="applications" role="tabpanel">

                <a asp-controller="Application"
                   asp-action="Create"
                   asp-route-caseId="@Model.Id"
                   class="btn btn-primary mb-3">
                    Add Application
                </a>

                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        @if (Context.Session.GetString("UserRole") == "Judge")
                        {
                            <th>Action</th>
                        }
                    </tr>
                    </thead>

                    <tbody>

                    @if (Model.Applications != null && Model.Applications.Any())
                    {
                        foreach (var a in Model.Applications)
                        {
                            <tr>
                                <td>@a.Type</td>
                                <td>
                                    @if (a.Status == "Filed")
                                    {
                                        <span class="badge badge-secondary">Filed</span>
                                    }
                                    else if (a.Status == "Listed")
                                    {
                                        <span class="badge badge-info">Listed</span>
                                    }
                                    else if (a.Status == "Granted")
                                    {
                                        <span class="badge badge-success">Granted</span>
                                    }
                                    else if (a.Status == "Rejected")
                                    {
                                        <span class="badge badge-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Pending</span>
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(a.Remarks) ? "—" : a.Remarks)
                                </td>
                                
                                @if (Context.Session.GetString("UserRole") == "Judge")
                                {
                                    <td>
                                        <a asp-controller="Application"
                                           asp-action="Edit"
                                           asp-route-id="@a.Id"
                                           class="btn btn-sm btn-primary">
                                            Update
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No applications filed</td>
                        </tr>
                    }

                    </tbody>
                </table>

            </div>
            
            <div class="tab-pane fade" id="timeline" role="tabpanel">
                <a asp-controller="Judge"
                   asp-action="CaseTimeline"
                   asp-route-caseId="@Model.Id"
                   class="btn btn-primary mb-3">
                    View Full Timeline
                </a>
                <ul class="timeline">

                    @if (Model.CaseEvents != null && Model.CaseEvents.Any())
                    {
                        foreach (var e in Model.CaseEvents.OrderByDescending(e => e.EventDate))
                        {
                            <li>
                                <span class="text-primary font-weight-bold">
                                    @e.EventDate.ToString("dd MMM yyyy")
                                </span>

                                <p>@e.EventType</p>
                                <small>@e.Description</small>
                            </li>
                        }
                    }
                    else
                    {
                        <li>No timeline events yet</li>
                    }

                </ul>
            </div>
            
            @* FIR Tab *@
            <div class="tab-pane fade" id="fir">

                @if (Model.FIR != null)
                {
                    <p><strong>FIR No:</strong> @Model.FIR.FIRNumber</p>
                    <p><strong>Police Station:</strong> @Model.FIR.PoliceStation</p>
                    <p>@Model.FIR.Description</p>
                }
                else
                {
                    @if (Context.Session.GetString("UserRole") == "Clerk")
                    {
                        <a asp-controller="FIR"
                           asp-action="Create"
                           asp-route-caseId="@Model.Id"
                           class="btn btn-primary">
                            Add FIR
                        </a>
                    }
                }

            </div>
            
            @* Chargesheet Tab *@
            <div class="tab-pane fade" id="chargesheet">

                <h5 class="mb-3">ChargeSheets</h5>

                <table class="table table-bordered">
                    @if (Model.ChargeSheet != null)
                    {
                        <table class="table table-bordered">
                            <tr>
                                <th>Charges</th>
                                <th>File</th>
                                <th>Download</th>
                            </tr>
                            <tr>
                                <td>@Model.ChargeSheet.Charges</td>
                                <td>@Model.ChargeSheet.FileName</td>
                                <td>
                                    <a href="@Model.ChargeSheet.FilePath" target="_blank" 
                                       class="btn btn-success btn-sm">
                                        View PDF
                                    </a>
                                </td>
                            </tr>
                        </table>
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                No ChargeSheet uploaded
                            </td>
                        </tr>
                    }
                </table>

            </div>
            
        </div>
    </div>
</div>

<div class="modal fade" id="hearingModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hearing Details</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p><strong>Judge:</strong> Hon. Justice A. Shah</p>
                <p><strong>Court:</strong> Surat District Court</p>
                <p><strong>Status:</strong> Scheduled</p>
                <p><strong>Remarks:</strong> Final arguments</p>
            </div>
        </div>
    </div>
</div>