@model CourtCaseManagementSystem.Core.Entities.Case

@{
    ViewData["Title"] = "Register Case";
}

<h2 class="mb-4">Register New Case</h2>

<form method="post">

    <!-- Case Info -->
    <div class="form-group">
        <label>Case Number</label>
        <input asp-for="CaseNumber" class="form-control" required />
    </div>

    <div class="form-group mt-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group mt-3">
        <label>Case Type</label>
        <select asp-for="CaseType" class="form-control">
            <option value="Civil">Civil</option>
            <option value="Criminal">Criminal</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <!-- Court -->
    <div class="form-group mt-3">
        <label>Court</label>
        <input type="text" id="courtSearch" class="form-control" placeholder="Search Court..." />

        <select name="CourtId" id="courtList" class="form-control mt-2">
            @foreach (var c in ViewBag.Courts)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>

    <!-- 🔥 MULTIPLE LAWYERS -->
    <div class="form-group mt-3">
        <label>Petitioner Lawyer</label>
        <select name="PetitionerLawyerId" class="form-control">
            @foreach (var l in ViewBag.Lawyers)
            {
                <option value="@l.Id">@l.FullName</option>
            }
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Respondent Lawyer</label>
        <select name="RespondentLawyerId" class="form-control">
            @foreach (var l in ViewBag.Lawyers)
            {
                <option value="@l.Id">@l.FullName</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-4">
        Register Case
    </button>
</form>

<script>
// Court search only
document.getElementById("courtSearch").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let options = document.getElementById("courtList").options;

    for (let i = 0; i < options.length; i++) {
        let text = options[i].text.toLowerCase();
        options[i].style.display = text.includes(filter) ? "" : "none";
    }
});
</script>