@model List<CourtCaseManagementSystem.Core.Entities.Document>

<h1 class="h3 mb-4 text-gray-800">Document Library</h1>

<table class="table table-bordered">

    <thead>
    <tr>
        <th>Case No</th>
        <th>Document</th>
        <th>Type</th>
        <th>Date</th>
        <th>Action</th>
    </tr>
    </thead>

    <tbody>

    @if (Model.Count == 0)
    {
        <tr>
            <td colspan="5" class="text-center">
                No documents available
            </td>
        </tr>
    }
    else
    {
        foreach (var doc in Model)
        {
            <tr>
                <td>@doc.Case?.CaseNumber</td>
                <td>@doc.FileName</td>
                <td>@doc.DocumentType</td>
                <td>@doc.UploadedAt.ToString("dd MMM yyyy")</td>

                <td>
                    <a asp-controller="Document"
                       asp-action="Download"
                       asp-route-id="@doc.Id"
                       class="btn btn-sm btn-primary">
                        Download
                    </a>
                </td>
            </tr>
        }
    }

    </tbody>

</table>