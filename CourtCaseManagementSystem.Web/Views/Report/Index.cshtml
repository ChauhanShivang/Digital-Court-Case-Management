@{
    ViewData["Title"] = "Reports & Analytics";
}

<h1 class="h3 mb-4 text-gray-800">Reports & Analytics</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-left-primary shadow py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                    Total Cases (This Year)
                </div>
                <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalCases</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">Case Distribution by Court</h6>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Total Active Cases</th>
                <th>Total Cases</th>
                <th>Closed Cases</th>
                <th>Total Hearings</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>@(ViewBag.TotalCases-ViewBag.ClosedCases)</td>
                <td>@ViewBag.TotalCases</td>
                <td>@ViewBag.ClosedCases</td>
                <td>@ViewBag.TotalHearings</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>