@{
    ViewData["Title"] = "Assign Judge";
}

<h1 class="h3 mb-4 text-gray-800">Assign Judge to Case</h1>

<div class="card shadow mb-4">
    <div class="card-body">

        <form method="post" asp-action="Assign">
            <div class="form-group">
                <label>Select Case</label>
                <select name="caseId" class="form-control">
                    @foreach (var c in ViewBag.Cases)
                    {
                        <option value="@c.Id">
                            @c.CaseNumber - @c.Title
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Select Judge</label>
                <input type="text" id="judgeSearch" class="form-control mb-2" placeholder="Search Judge..." />

                <select name="judgeId" id="judgeList" class="form-control mt-2">
                    @foreach (var j in ViewBag.Judges)
                    {
                        <option value="@j.Id">@j.FullName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>First Hearing Date</label>
                <input type="date" class="form-control" />
            </div>

            <button class="btn btn-primary">Assign Judge</button>
        </form>

    </div>
</div>



<script>
document.addEventListener("DOMContentLoaded", function () {

    const searchBox = document.getElementById("judgeSearch");
    const list = document.getElementById("judgeList");

    if (!searchBox || !list) return;

    searchBox.addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let options = list.options;

        for (let i = 0; i < options.length; i++) {
            let text = options[i].text.toLowerCase();
            options[i].style.display = text.includes(filter) ? "" : "none";
        }
    });

});
</script>