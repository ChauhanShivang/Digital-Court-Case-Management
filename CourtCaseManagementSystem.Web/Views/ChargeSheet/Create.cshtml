@model CourtCaseManagementSystem.Core.Entities.ChargeSheet

<h2>Upload ChargeSheet</h2>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" name="CaseId" value="@ViewBag.CaseId" />

    <div class="form-group">
        <label>Charges Description</label>
        <textarea name="Charges" class="form-control"></textarea>
    </div>

    <div class="form-group mt-3">
        <label>Upload PDF</label>
        <input type="file" name="file" class="form-control" accept=".pdf" required />
    </div>

    <button class="btn btn-primary mt-3">Upload</button>
</form>